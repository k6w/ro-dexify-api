{
  "name": "ro-dexify-api",
  "version": "2.0.0",
  "description": "Romanian dictionary aggregator API: DOOM, DEXonline, m.dex.ro, Wiktionary RO, Forvo, DLR/TEZAUR, conjugation, pluralization.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "start": "node dist/index.js",
    "bootstrap": "tsx scripts/setup.ts",
    "seed": "tsx scripts/setup.ts --no-install",
    "db:reset": "tsx scripts/setup.ts --refresh",
    "fixtures:refresh": "tsx scripts/refresh-fixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "format": "biome format --write src tests scripts"
  },
  "keywords": [
    "romanian",
    "dictionary",
    "dexonline",
    "doom",
    "wiktionary",
    "forvo",
    "dlr",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.18.3",
    "@hono/zod-validator": "^0.4.2",
    "better-sqlite3": "^11.5.0",
    "cockatiel": "^3.2.1",
    "fast-xml-parser": "^4.5.1",
    "hono": "^4.6.14",
    "linkedom": "^0.18.6",
    "lru-cache": "^11.0.2",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "plural-ro": "^1.0.0",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^2.13.1",
    "ulid": "^2.3.0",
    "undici": "^7.1.1",
    "wtf_wikipedia": "^10.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.13.0",
    "@vitest/coverage-v8": "^2.1.8",
    "nock": "^13.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
